# Nomor WhatsApp Anda (penerima soal), format internasional tanpa + / spasi. Contoh: 6281234567890
OWNER_NUMBER=
# Nama panggilan di sapaan
OWNER_NAME=Ikbal
# Token untuk membuka halaman QR: http://SERVER:PORT/qr?token=...
ADMIN_TOKEN=ganti-dengan-string-acak-panjang
PORT=3100
# Sumber bank pertanyaan & penilai jawaban (app English 90 Hari di GitHub Pages)
APP_BASE_URL=https://ikbalyuliyanto.github.io/english-90-hari/
# Worker untuk current day (GET /state). Kosongkan untuk memakai REVIEW_MAX_DAY saja.
WORKER_BASE_URL=https://english-90-hari-push.ikbaly94.workers.dev
REVIEW_MAX_DAY=20
# Menit: ulangi pengingat soal yang belum dijawab / jeda setelah jawaban benar
REMINDER_INTERVAL_MIN=15
COOLDOWN_MIN=10
TZ=Asia/Jakarta
